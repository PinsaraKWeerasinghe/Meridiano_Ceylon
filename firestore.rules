rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Trip ledger refs: package P05B00001, specialty S00A00001, flash FSUM00001.
    function bookingTripRefIsValid() {
      return request.resource.data.tripRef is string
        && (request.resource.data.tripRef.matches('^P[0-9]{2}[A-Z][0-9]{5}$')
          || request.resource.data.tripRef.matches('^S[0-9]{2}[A-Z][0-9]{5}$')
          || request.resource.data.tripRef.matches('^F[A-Z]{3}[0-9]{5}$'));
    }

    function tripCounterKeyIsValid(key) {
      return key.matches('^P[0-9]{2}[A-Z]$')
        || key.matches('^S[0-9]{2}[A-Z]$')
        || key.matches('^F[A-Z]{3}$');
    }

    function bookingPaymentStatusAllowed(v) {
      return v is string && (
        v == 'pending-payment'
        || v == 'advance-paid'
        || v == 'payment-completed'
        || v == 'pending-refund'
        || v == 'refunded'
        || v == 'not-applicable'
        || v == 'refund-request-initiated'
      );
    }

    /** Owner cancel from My Bookings: trip canceled; payment transitions per unpaid vs paid ledger. */
    function bookingLedgerSelfCancelPaymentTransition() {
      return (resource.data.paymentStatus == 'pending-payment'
          && request.resource.data.paymentStatus == 'not-applicable')
        || ((resource.data.paymentStatus == 'advance-paid'
             || resource.data.paymentStatus == 'payment-completed')
            && request.resource.data.paymentStatus == 'refund-request-initiated')
        || (!(resource.data.paymentStatus == 'pending-payment'
              || resource.data.paymentStatus == 'advance-paid'
              || resource.data.paymentStatus == 'payment-completed')
            && request.resource.data.paymentStatus == resource.data.paymentStatus);
    }

    function bookingLedgerSelfCancelAllowed(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && bookingLedgerCoreImmutableForAdminPatch()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['paymentStatus', 'tripStatus'])
        && bookingPaymentStatusAllowed(request.resource.data.paymentStatus)
        && bookingTripStatusAllowed(request.resource.data.tripStatus)
        && resource.data.tripStatus != 'canceled'
        && request.resource.data.tripStatus == 'canceled'
        && bookingLedgerSelfCancelPaymentTransition();
    }

    function bookingTripStatusAllowed(v) {
      return v is string && (
        v == 'pending-payment'
        || v == 'booking-confirmed'
        || v == 'trip-started'
        || v == 'trip-completed'
        || v == 'canceled'
      );
    }

    function bookingLedgerTripRefsUnchanged() {
      return (!resource.data.keys().hasAny(['tripRef']))
        ? (!request.resource.data.keys().hasAny(['tripRef']))
        : (request.resource.data.keys().hasAny(['tripRef'])
            && request.resource.data.tripRef == resource.data.tripRef);
    }

    function bookingLedgerPackageCoreImmutable() {
      return request.resource.data.kind == resource.data.kind
        && request.resource.data.kind == 'package'
        && request.resource.data.typeLabel == resource.data.typeLabel
        && request.resource.data.bookingDate == resource.data.bookingDate
        && request.resource.data.packageSlug == resource.data.packageSlug
        && request.resource.data.flashDealDocId == resource.data.flashDealDocId
        && bookingLedgerTripRefsUnchanged()
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    /** Slim flash omits duplicated display fields; legacy rows keep them immutable; no new unsolicited keys. */
    function bookingLedgerFlashLegacyDisplayFieldsStable() {
      return (resource.data.keys().hasAny(['typeLabel'])
          ? request.resource.data.typeLabel == resource.data.typeLabel
          : !request.resource.data.keys().hasAny(['typeLabel']))
        && (resource.data.keys().hasAny(['bookingDate'])
          ? request.resource.data.bookingDate == resource.data.bookingDate
          : !request.resource.data.keys().hasAny(['bookingDate']))
        && (resource.data.keys().hasAny(['packageSlug'])
          ? request.resource.data.packageSlug == resource.data.packageSlug
          : !request.resource.data.keys().hasAny(['packageSlug']));
    }

    function bookingLedgerFlashCoreImmutable() {
      return request.resource.data.kind == resource.data.kind
        && request.resource.data.kind == 'flash-deal'
        && request.resource.data.flashDealDocId == resource.data.flashDealDocId
        && bookingLedgerTripRefsUnchanged()
        && bookingLedgerFlashLegacyDisplayFieldsStable()
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    /** Admin edits payment/trip lifecycle only — core traveller row stays fixed (shape depends on kind). */
    function bookingLedgerCoreImmutableForAdminPatch() {
      return (resource.data.kind == 'package'
          && bookingLedgerPackageCoreImmutable())
        || (resource.data.kind == 'flash-deal'
          && bookingLedgerFlashCoreImmutable());
    }

    function ledgerPackageBookingCreateAllowed() {
      return request.resource.data.keys().hasOnly([
        'kind', 'typeLabel', 'bookingDate', 'packageSlug',
        'flashDealDocId', 'tripRef', 'createdAt',
        'paymentStatus', 'tripStatus'
      ])
        && request.resource.data.kind == 'package'
        && request.resource.data.typeLabel is string
        && request.resource.data.bookingDate is string
        && request.resource.data.packageSlug is string
        && request.resource.data.flashDealDocId is string
        && bookingTripRefIsValid()
        && request.resource.data.paymentStatus == 'pending-payment'
        && request.resource.data.tripStatus == 'pending-payment'
        && request.resource.data.createdAt == request.time;
    }

    /** Role is enforced on Firestore profile docs (`users/{uid}.role`). */
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function flashDealSlotsTakenIncrement() {
      return request.auth != null
        && maxSlotsIsPositive(resource.data)
        && dealCampaignImmutableExceptSlotsTaken()
        && slotsTakenIsNonNegative(request.resource.data.slotsTaken)
        && request.resource.data.slotsTaken <= resource.data.maxSlots
        && request.resource.data.slotsTaken == prevSlotsTaken(resource.data) + 1;
    }

    /**
     * MapDiff / changedKeys is unreliable for client patch merges — lock every stored
     * campaign field except `slotsTaken`, plus audit timestamps untouched.
     */
    function dealCampaignImmutableExceptSlotsTaken() {
      return request.resource.data.title == resource.data.title
        && request.resource.data.dealDate == resource.data.dealDate
        && request.resource.data.disabled == resource.data.disabled
        && request.resource.data.isFeatured == resource.data.isFeatured
        && request.resource.data.description == resource.data.description
        && request.resource.data.fixedTourStartDate == resource.data.fixedTourStartDate
        && request.resource.data.fixedTourEndDate == resource.data.fixedTourEndDate
        && request.resource.data.perPersonCharge == resource.data.perPersonCharge
        && request.resource.data.groupSize == resource.data.groupSize
        && request.resource.data.hotelLevel == resource.data.hotelLevel
        && request.resource.data.transport == resource.data.transport
        && request.resource.data.itinerarySnaps == resource.data.itinerarySnaps
        && request.resource.data.registrationPrice == resource.data.registrationPrice
        && request.resource.data.maxSlots == resource.data.maxSlots
        && (!resource.data.keys().hasAny(['createdByUid'])
          || request.resource.data.createdByUid == resource.data.createdByUid)
        && (!resource.data.keys().hasAny(['createdByEmail'])
          || request.resource.data.createdByEmail == resource.data.createdByEmail)
        && (!resource.data.keys().hasAny(['createdAt'])
          || request.resource.data.createdAt == resource.data.createdAt)
        && (!resource.data.keys().hasAny(['updatedAt'])
          || request.resource.data.updatedAt == resource.data.updatedAt)
        && (!resource.data.keys().hasAny(['lastModifiedByUid'])
          || request.resource.data.lastModifiedByUid == resource.data.lastModifiedByUid)
        && (!resource.data.keys().hasAny(['lastModifiedByEmail'])
          || request.resource.data.lastModifiedByEmail == resource.data.lastModifiedByEmail);
    }

    /** The data source often stores JS numbers as floats; accept int or whole floats. */
    function maxSlotsIsPositive(data) {
      return (data.maxSlots is int || data.maxSlots is float)
        && data.maxSlots >= 1;
    }

    function slotsTakenIsNonNegative(v) {
      return (v is int || v is float) && v >= 0;
    }

    function prevSlotsTaken(data) {
      return data.keys().hasAny(['slotsTaken'])
        && slotsTakenIsNonNegative(data.slotsTaken)
        ? data.slotsTaken
        : 0;
    }

    /** `serverTimestamp()` is represented as `request.time` during rule evaluation. */
    function submittedAtAllowed() {
      return request.resource.data.submittedAt == request.time
        || request.resource.data.submittedAt is timestamp;
    }

    /** Ledger + traveller snapshot at `users/{uid}/flashDeals/{campaignId}` — not under Bookings. */
    function userFlashDealProfileCreateAllowed(cidFromPath) {
      return request.resource.data.flashDealDocId == cidFromPath
        && request.resource.data.keys().hasOnly([
          'addonTitles', 'createdAt', 'estimatedBillLines',
          'flashDealDocId', 'kind', 'notes', 'packageSlug', 'packageTitle',
          'partners', 'paymentStatus', 'phone', 'primaryGender',
          'primaryName', 'primaryPassport', 'submittedAt', 'submitterEmail',
          'tripRef', 'tripStatus'
        ])
        && request.resource.data.kind == 'flash-deal'
        && bookingTripRefIsValid()
        && request.resource.data.paymentStatus == 'pending-payment'
        && request.resource.data.tripStatus == 'pending-payment'
        && request.resource.data.createdAt == request.time
        && request.resource.data.packageSlug is string
        && request.resource.data.packageTitle is string
        && request.resource.data.primaryName is string
        && request.resource.data.primaryPassport is string
        && request.resource.data.primaryGender is string
        && (request.resource.data.primaryGender == 'male'
          || request.resource.data.primaryGender == 'female')
        && request.resource.data.partners is list
        && request.resource.data.partners.size() <= 30
        && request.resource.data.phone is string
        && request.resource.data.addonTitles is list
        && request.resource.data.notes is string
        && request.resource.data.estimatedBillLines is list
        && submittedAtAllowed()
        && (request.resource.data.submitterEmail == null
          || request.resource.data.submitterEmail is string);
    }

    /** Locks traveller snapshot + Trip ID counters for admin ledger patches and owner self-cancel. */
    function userFlashDealProfileImmutableSnapshotForLedgerPatch() {
      return request.resource.data.flashDealDocId == resource.data.flashDealDocId
        && request.resource.data.kind == resource.data.kind
        && request.resource.data.kind == 'flash-deal'
        && request.resource.data.tripRef == resource.data.tripRef
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.submittedAt == resource.data.submittedAt
        && request.resource.data.packageSlug == resource.data.packageSlug
        && request.resource.data.packageTitle == resource.data.packageTitle
        && request.resource.data.primaryName == resource.data.primaryName
        && request.resource.data.primaryPassport == resource.data.primaryPassport
        && request.resource.data.primaryGender == resource.data.primaryGender
        && request.resource.data.partners == resource.data.partners
        && request.resource.data.phone == resource.data.phone
        && request.resource.data.addonTitles == resource.data.addonTitles
        && request.resource.data.notes == resource.data.notes
        && request.resource.data.estimatedBillLines == resource.data.estimatedBillLines
        && request.resource.data.submitterEmail == resource.data.submitterEmail;
    }

    function userFlashDealProfileSelfCancelAllowed(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && userFlashDealProfileImmutableSnapshotForLedgerPatch()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['paymentStatus', 'tripStatus'])
        && bookingPaymentStatusAllowed(request.resource.data.paymentStatus)
        && bookingTripStatusAllowed(request.resource.data.tripStatus)
        && resource.data.tripStatus != 'canceled'
        && request.resource.data.tripStatus == 'canceled'
        && bookingLedgerSelfCancelPaymentTransition();
    }

    // Users collection
    match /users/{userId} {

      // User can access own document
      // Admin can access all user documents
      allow read, write: if request.auth != null &&
                         (request.auth.uid == userId || isAdmin());
    }

    // Flash-deal traveller + ledger: `users/{uid}/flashDeals/{campaignId}` — same doc id as `flashDeals/{campaignId}`.
    match /users/{userId}/flashDeals/{flashDealCampaignId} {
      allow read: if request.auth != null &&
                  (request.auth.uid == userId || isAdmin());

      allow create: if request.auth != null
        && request.auth.uid == userId
        && exists(/databases/$(database)/documents/flashDeals/$(flashDealCampaignId))
        && userFlashDealProfileCreateAllowed(flashDealCampaignId);

      allow update: if (isAdmin()
        && userFlashDealProfileImmutableSnapshotForLedgerPatch()
        && bookingPaymentStatusAllowed(request.resource.data.paymentStatus)
        && bookingTripStatusAllowed(request.resource.data.tripStatus))
        || userFlashDealProfileSelfCancelAllowed(userId);

      allow delete: if false;
    }

    // User booking ledger (package enquiries; legacy flash-deal rows may remain)
    match /users/{userId}/Bookings/{bookingId} {
      /** Try admin first — collection-group ledger queries rely on stable admin authorization. */
      allow read: if request.auth != null
        && (isAdmin() || request.auth.uid == userId);

      allow create: if request.auth != null
        && request.auth.uid == userId
        && ledgerPackageBookingCreateAllowed();

      allow update: if (isAdmin()
        && bookingLedgerCoreImmutableForAdminPatch()
        && bookingPaymentStatusAllowed(request.resource.data.paymentStatus)
        && bookingTripStatusAllowed(request.resource.data.tripStatus))
        || bookingLedgerSelfCancelAllowed(userId);

      allow delete: if false;
    }

    // Monotonic next counters for Trip IDs (writes align with Bookings / user flashDeal ledger txs).
    // next holds the latest allocated sequence (1..n) for segmentKey + 5-digit suffix.
    match /tripRefCounters/{segmentKey} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && tripCounterKeyIsValid(segmentKey)
        && request.resource.data.keys().hasOnly(['next'])
        && request.resource.data.next is int
        && request.resource.data.next == 1;

      allow update: if request.auth != null
        && tripCounterKeyIsValid(segmentKey)
        && resource.data.keys().hasOnly(['next'])
        && request.resource.data.keys().hasOnly(['next'])
        && request.resource.data.next is int
        && resource.data.next is int
        && request.resource.data.next == resource.data.next + 1;

      allow delete: if false;
    }

    // Flash Deal Settings collection
    match /flashDeals/{docId} {

      // Any user can read flash deals
      allow read: if true;

      allow create: if isAdmin();

      allow update: if isAdmin() || flashDealSlotsTakenIncrement();

      // Admin-only delete. The Travellers subcollection is preserved as an
      // audit trail (its own rule still blocks client deletes).
      allow delete: if isAdmin();
    }
    
    match /flashDeals/{dealId}/Travellers/{travellerUid} {
      allow read: if request.auth != null &&
                  (isAdmin() || request.auth.uid == travellerUid);

      /** Traveller confirmations are immutable after first write (audit snapshot). */
      allow create: if request.auth != null
        && request.auth.uid == travellerUid
        && dealId == request.resource.data.flashDealDocId
        && exists(/databases/$(database)/documents/flashDeals/$(dealId))
        && request.resource.data.keys().hasOnly([
          'flashDealDocId', 'packageSlug', 'packageTitle', 'primaryName',
          'primaryPassport', 'primaryGender', 'partners', 'phone',
          'addonTitles', 'notes', 'estimatedBillLines', 'submitterEmail',
          'submittedAt'
        ])
        && request.resource.data.packageSlug is string
        && request.resource.data.packageTitle is string
        && request.resource.data.primaryName is string
        && request.resource.data.primaryPassport is string
        && request.resource.data.primaryGender is string
        && (request.resource.data.primaryGender == 'male'
          || request.resource.data.primaryGender == 'female')
        && request.resource.data.partners is list
        && request.resource.data.partners.size() <= 30
        && request.resource.data.phone is string
        && request.resource.data.addonTitles is list
        && request.resource.data.notes is string
        && request.resource.data.estimatedBillLines is list
        && submittedAtAllowed()
        && (request.resource.data.submitterEmail == null
          || request.resource.data.submitterEmail is string);

      allow update, delete: if false;
    }
    
  }
}
