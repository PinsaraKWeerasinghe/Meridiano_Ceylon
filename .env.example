# Local dev: copy to `.env.local` (Next.js loads `.env*.local` in development).
#
# Production: use committed `.env.production` (picked up on `next build` / Vercel),
# or set the same keys in Vercel → Settings → Environment Variables.

NEXT_PUBLIC_WHATSAPP_NUMBER=

# PayHere (server-side; add to `.env.local` — never expose MERCHANT_SECRET to the client)
# PAYHERE_MERCHANT_ID=
# PAYHERE_MERCHANT_SECRET=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional — only if you use Google Analytics in Firebase
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Trustpilot TrustBox — from Trustpilot Business → Integrations → TrustBox (Business unit ID).
# Carousel template matches by default; set NEXT_PUBLIC_TRUSTPILOT_TEMPLATE_ID if you use another widget.
NEXT_PUBLIC_TRUSTPILOT_BUSINESS_UNIT_ID=
# NEXT_PUBLIC_TRUSTPILOT_TEMPLATE_ID=
# NEXT_PUBLIC_TRUSTPILOT_REVIEW_PAGE_URL=https://www.trustpilot.com/review/…
# NEXT_PUBLIC_TRUSTPILOT_LOCALE=en-US
# NEXT_PUBLIC_TRUSTPILOT_STYLE_HEIGHT=260px
# NEXT_PUBLIC_TRUSTPILOT_STYLE_WIDTH=100%
# NEXT_PUBLIC_TRUSTPILOT_THEME=light

# Optional Google Maps embed (fallback when SociableKIT embed ID is unset).
# NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=https://www.google.com/maps/embed?pb=
# SociableKIT Google Reviews — numeric data-embed-id (iframe URL ends with `/iframe/<id>`).
# NEXT_PUBLIC_SOCIABLEKIT_GOOGLE_REVIEWS_EMBED_ID=

# NEXT_PUBLIC_MAINTENANCE_MODE=true
# NEXT_PUBLIC_MAINTENANCE_INFO_EMAIL=info@meridianoceylon.com
# NEXT_PUBLIC_MAINTENANCE_BOOKINGS_EMAIL=bookings@meridianoceylon.com
